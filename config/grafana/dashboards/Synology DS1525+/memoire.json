{
  "uid": "nas-memoire",
  "title": "Mémoire NAS",
  "tags": [
    "nas",
    "memoire"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "RAM disponible",
      "description": "MemAvailable : la memoire reellement recuperable sans swap. Alerte < 1 Gio.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "node_memory_MemAvailable_bytes/1024/1024/1024",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 8
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Debit d'ecriture swap",
      "description": "rate(pswpout) : pages ecrites vers le swap. 0 = swap inactif, meme s'il est plein. C'est le signal de pression memoire reelle (alerte swap-active).",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "rate(node_vmstat_pswpout[5m])",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Swap occupe (info)",
      "description": "Taux d'occupation du swap. Un swap plein mais sans ecriture = pages froides, pas de probleme immediat.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "(1-node_memory_SwapFree_bytes/node_memory_SwapTotal_bytes)*100",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "OOM kills (24 h)",
      "description": "Processus tues par le noyau sur 24 h (alerte oom-kill-detected sur 10 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "increase(node_vmstat_oom_kill[24h])",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RAM disponible vs swap utilise",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "RAM disponible"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "node_memory_SwapTotal_bytes-node_memory_SwapFree_bytes",
          "legendFormat": "Swap utilise"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Activite swap (pages/s)",
      "description": "Ecritures (out) et lectures (in) du swap.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "rate(node_vmstat_pswpout[5m])",
          "legendFormat": "swap out"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "rate(node_vmstat_pswpin[5m])",
          "legendFormat": "swap in"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Conteneurs : % de la limite memoire",
      "description": "Conteneurs avec limite uniquement (alerte > 90 %).",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "topk(10, max by (name) (container_memory_working_set_bytes{name!=\"\"} / (container_spec_memory_limit_bytes{name!=\"\"} > 0)) * 100)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Conteneurs : memoire utilisee (top 10)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "topk(10, container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
