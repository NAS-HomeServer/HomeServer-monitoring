            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "namespace 2": true,
              "namespace 3": true,
              "Value #A": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "namespace 1": "Namespace",
              "pod": "Pod",
              "phase": "Phase",
              "Value #B": "Prêt",
              "Value #C": "Redémarrages"
            },
            "indexByName": {
              "Namespace": 0,
              "Pod": 1,
              "Phase": 2,
              "Prêt": 3,
              "Redémarrages": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Namespace"
              },
              {
                "field": "Pod"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Phase"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Running": {
                        "text": "Running",
                        "color": "green",
                        "index": 0
                      },
                      "Pending": {
                        "text": "Pending",
                        "color": "orange",
                        "index": 1
                      },
                      "Failed": {
                        "text": "Failed",
                        "color": "red",
                        "index": 2
                      },
                      "Succeeded": {
                        "text": "Succeeded",
                        "color": "blue",
                        "index": 3
                      },
                      "Unknown": {
                        "text": "Unknown",
                        "color": "red",
                        "index": 4
                      }
