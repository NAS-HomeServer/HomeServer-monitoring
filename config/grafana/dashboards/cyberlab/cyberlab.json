    {
      "id": 13,
      "type": "table",
      "title": "État des conteneurs",
      "datasource": {
        "type": "prometheus",
        "uid": "cfe5m371sd62of"
      },
      "description": "UP si cAdvisor a vu le conteneur il y a moins de 120 s (même critère que CyberlabContainerDown), DOWN sinon. Une ligne par conteneur du compose cyberlab.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cfe5m371sd62of"
          },
          "expr": "max by (name) ((time() - container_last_seen{name=~\"sherlock|dns_analyzer|audit_orchestrator|cloudflared_(sherlock|dns_analyzer|audit_orchestrator)\"}) < bool 120)\nor on (name)\n(label_replace(vector(0), \"name\", \"sherlock\", \"\", \"\") or label_replace(vector(0), \"name\", \"dns_analyzer\", \"\", \"\") or label_replace(vector(0), \"name\", \"audit_orchestrator\", \"\", \"\") or label_replace(vector(0), \"name\", \"cloudflared_sherlock\", \"\", \"\") or label_replace(vector(0), \"name\", \"cloudflared_dns_analyzer\", \"\", \"\") or label_replace(vector(0), \"name\", \"cloudflared_audit_orchestrator\", \"\", \"\"))",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "name",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "^${container:regex}$"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "name",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Conteneur",
              "Value": "État"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "État"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
