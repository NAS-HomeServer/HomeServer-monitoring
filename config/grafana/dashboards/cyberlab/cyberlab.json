          "expr": "label_replace(label_replace(probe_success{job=~\"blackbox-cyberlab-(external|internal)\", instance=~\"$instance\"}, \"cible\", \"$1\", \"instance\", \"https?://(.*)\"), \"cible\", \"$1\", \"cible\", \"(.*)\\\\.axelginepro\\\\.workers\\\\.dev.*\")",
